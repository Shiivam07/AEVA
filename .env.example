# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=charchit
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=charchit_db
DATABASE_URL="postgresql://charchit:change_me_in_production@localhost:5432/charchit_db?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Admin Provisioning ──────────────────────────────────────────────────────
# Used ONLY by the one-time seed command. Never expose this in the frontend.
ADMIN_PROVISION_SECRET=replace_with_a_long_random_secret

# ─── File Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Client ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
